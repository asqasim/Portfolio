{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio on Cloudflare Workers: static site, rate-limited AI assistant, first-party analytics and a private admin panel.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute portfolio-limits --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute portfolio-limits --local --file=schema.sql",
    "secrets": "node tools/setup-secrets.mjs",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "devDependencies": {
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": ">=20"
  }
}
